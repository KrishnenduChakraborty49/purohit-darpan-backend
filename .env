# ===================================================================
# Purohit Darpan — Backend Environment Variables
# ===================================================================

# ── Database ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=purohit_darpan
DB_USERNAME=root
DB_PASSWORD=yourpassword

# ── JWT ──────────────────────────────────────────────────────────
JWT_SECRET=purohit-darpan-super-secret-key-must-be-at-least-256-bits-long-for-hs256
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ── OpenAI (Spring AI) ───────────────────────────────────────────
# Replace with your real key to enable AI features
OPENAI_API_KEY=sk-placeholder-not-configured

# ── Firebase Admin SDK ───────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
FIREBASE_PROJECT_ID=purohit-darpan

# ── Panchang API ─────────────────────────────────────────────────
PANCHANG_API_URL=https://api.vedicastroapi.com/v3-json
PANCHANG_API_KEY=mock
PANCHANG_USE_MOCK=true

# ── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Server ───────────────────────────────────────────────────────
SERVER_PORT=8080

# ── Spring Profile ────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
